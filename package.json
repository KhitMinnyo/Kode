{
  "name": "kode",
  "version": "1.1.2",
  "description": "Kode — AI Coding & Cybersecurity Agent powered by Ollama",
  "repository": "https://github.com/KhitMinnyo/Kode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "bash src/renderer/vendor/fetch-vendor-libs.sh || true",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:zip": "electron-builder --mac zip",
    "build:linux": "electron-builder --linux",
    "build:deb": "electron-builder --linux deb",
    "build:win": "electron-builder --win",
    "build:exe": "electron-builder --win nsis",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . --ext .js"
  },
  "author": {
    "name": "Khit Minnyo",
    "email": "khit.minnyo@icloud.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "jsdom": "^30.0.1"
  },
  "build": {
    "appId": "com.kode.agent",
    "productName": "Kode",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Kode",
      "backgroundColor": "#0f0f23",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "icon.png",
      "desktop": {
        "entry": {
          "Name": "Kode",
          "Comment": "AI Coding & Cybersecurity Agent",
          "Terminal": "false",
          "Categories": "Development;Utility;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "priority": "optional"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "icon.png",
      "src/**/*",
      "!node_modules/.cache"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
