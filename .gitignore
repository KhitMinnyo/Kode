# Dependencies
node_modules/
# Build output
dist/
out/
# Electron binaries
*.dmg
*.blockmap
*.zip
*.exe
*.AppImage
*.deb
*.rpm
*.snap
builder-debug.yml
# macOS
.DS_Store
*.swp
Thumbs.db
# IDE
.vscode/
.idea/
*.sublime-*
# Logs
*.log
npm-debug.log*
# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa*
# App data (user-specific) — normally lives outside the repo in Electron's userData
# dir, but ignored here too in case it's ever created/tested inside the project folder
kode-chats.json
kode-projects.json
kode-settings.json
# Local persistent-memory / knowledge-base data (per-project "brain" storage, written
# to <project>/.kode/memory.json by the save_memory/recall_memory tools) — this is
# personal working data, not something that should end up in a public repo
.kode/
# Test coverage output
coverage/
# Vendored third-party UI libraries (highlight.js, marked, DOMPurify) — exact,
# unmodified upstream builds fetched via src/renderer/vendor/fetch-vendor-libs.sh,
# same reasoning as not committing node_modules. Keep the folder's own README/script.
src/renderer/vendor/*.js
src/renderer/vendor/*.css

# Scratch/junk relocated here for the user to delete manually via Finder (this
# sandbox's git operations can't actually delete files) — never meant to be
# committed; a prior manual commit accidentally picked these up once already.
_to_delete/
# Auto-saved copy the Claude desktop app writes locally when a file is
# delivered in chat — not project content.
Claude outputs/
